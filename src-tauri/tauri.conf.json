{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeatMaker",
  "version": "0.1.0",
  "identifier": "local.beatmaker.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BeatMaker",
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
